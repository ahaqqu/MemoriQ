# Immich release version. Pin to a concrete release for reproducible deployments.
# Change this value deliberately after reading the release notes, then run ./immich/update.sh.
IMMICH_VERSION=v1.131.3

# Server timezone (used for jobs and metadata). Change to your local timezone, e.g. Asia/Jakarta.
TZ=UTC

# Database configuration. setup.sh generates DB_PASSWORD automatically on first run.
DB_HOSTNAME=immich_postgres
DB_USERNAME=postgres
DB_PASSWORD=SET_BY_SETUP_SCRIPT
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=../data/immich/postgres

# Photo and video storage. Keep this outside the git tree if you prefer; the default is git-ignored.
UPLOAD_LOCATION=../data/immich/photos

# Optional: enable telemetry. Set to "all" to include metrics, or leave unset to disable.
# IMMICH_TELEMETRY_INCLUDE=
